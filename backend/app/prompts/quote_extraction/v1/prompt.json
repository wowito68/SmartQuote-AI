{
  "name": "quote_extraction",
  "version": "1.0.0",
  "schema_version": "1.0.0",
  "description": "Extract supplier quote line items with page-level evidence. Values are candidates for human review, not purchasing decisions.",
  "instructions": "Extract only information explicitly supported by the supplier quote. Do not invent prices, delivery times, brands, models or compliance. Use null when a value is not present. technical_compliance must only be true when the quote explicitly supports compliance, false when it explicitly indicates non-compliance, otherwise null. Evidence fragments must be short verbatim fragments present on the cited page.",
  "user_template": "Quote document {document_id}. Extract the supplier quote items from these pages:\n\n{pages}",
  "output_schema": {
    "type": "object",
    "additionalProperties": false,
    "properties": {
      "items": {
        "type": "array",
        "items": {
          "type": "object",
          "additionalProperties": false,
          "properties": {
            "product_name": {"type": "string", "minLength": 1},
            "brand": {"type": ["string", "null"]},
            "model": {"type": ["string", "null"]},
            "quantity": {"type": ["number", "null"], "minimum": 0},
            "unit_price": {"type": ["number", "null"], "minimum": 0},
            "total_price": {"type": ["number", "null"], "minimum": 0},
            "currency": {"type": ["string", "null"]},
            "delivery_days": {"type": ["integer", "null"], "minimum": 0},
            "technical_compliance": {"type": ["boolean", "null"]},
            "notes": {"type": ["string", "null"]},
            "evidence": {
              "type": "object",
              "additionalProperties": false,
              "properties": {
                "page": {"type": "integer", "minimum": 1},
                "fragment": {"type": "string", "minLength": 1},
                "confidence": {"type": "number", "minimum": 0, "maximum": 1}
              },
              "required": ["page", "fragment", "confidence"]
            }
          },
          "required": [
            "product_name",
            "brand",
            "model",
            "quantity",
            "unit_price",
            "total_price",
            "currency",
            "delivery_days",
            "technical_compliance",
            "notes",
            "evidence"
          ]
        }
      }
    },
    "required": ["items"]
  }
}
